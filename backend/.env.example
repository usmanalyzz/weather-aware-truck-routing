OPEN_METEO_LOCATIONS_PER_MINUTE=570
OPEN_METEO_MAX_WAIT_S=15
HEATMAP_MAX_WAIT_S=40
API_THROTTLE_RATE=120/min
PLAN_THROTTLE_RATE=20/min
HEATMAP_THROTTLE_RATE=20/min
SUGGEST_THROTTLE_RATE=120/min
LOG_LEVEL=INFO
